<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Chr.Avro.Binary" Version="10.13.1" />
    <PackageReference Include="Chr.Avro.Json" Version="10.13.1" />
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="DotPulsar" Version="5.3.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
		<ProjectReference Include="..\PoC.Pulsar.TableView.Contracts\PoC.Pulsar.TableView.Contracts.csproj" />
		<None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\samples\publish\*.json" Link="samples\publish\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\PoC.Pulsar.TableView.Contracts\AvroSchemas\*.avsc" Link="AvroSchemas\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
